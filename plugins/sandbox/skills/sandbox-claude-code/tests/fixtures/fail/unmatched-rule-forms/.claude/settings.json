{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Write(./src/**)",
      "NotebookEdit(./notebooks/**)",
      "Glob(./secrets/**)"
    ]
  }
}
