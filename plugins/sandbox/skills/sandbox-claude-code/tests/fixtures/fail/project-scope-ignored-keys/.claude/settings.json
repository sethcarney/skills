{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": { "disabled": false },
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "strictAllowlist": true
    }
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(~/.ssh/**)", "Read(~/.aws/**)"]
  }
}
